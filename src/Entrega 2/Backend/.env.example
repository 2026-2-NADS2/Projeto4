# Porta da API
PORT=3000

# PostgreSQL (Neon ou instância local)
DATABASE_HOST=seu-host.neon.tech
DATABASE_PORT=5432
DATABASE_NAME=neondb
DATABASE_USER=seu_usuario
DATABASE_PASSWORD=sua_senha
# Use false apenas para PostgreSQL local sem SSL
DATABASE_SSL=true

# Segredo de assinatura dos tokens JWT.
# Gere um valor aleatório longo, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h

# Origens permitidas no navegador (separe por vírgula).
# Em produção, informe o domínio público do frontend.
CORS_ORIGIN=http://localhost:5173
