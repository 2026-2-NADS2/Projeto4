# URL da API Express usada pelo frontend em produção/desenvolvimento.
# Em desenvolvimento, use /api para o proxy do Vite (vite.config.js).
# Em produção com front e back no mesmo domínio, mantenha /api.
# Se a API estiver em outro domínio, informe a URL pública terminando em /api:
# VITE_API_URL=https://kfka-api.exemplo.com/api
VITE_API_URL=/api
